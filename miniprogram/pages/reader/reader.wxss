.wrap {
  padding-top: 28rpx;
  padding-bottom: 60rpx;
}

.reader-head {
  border-bottom: 1rpx solid var(--border-2);
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
}

.reader-title {
  font-family: var(--title-font);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.5;
}

.reader-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.b-p {
  font-size: 30rpx;
  line-height: 1.9;
  margin-bottom: 24rpx;
  color: var(--text);
}

.b-h {
  font-family: var(--title-font);
  font-size: 34rpx;
  font-weight: 700;
  margin: 32rpx 0 18rpx;
}

.b-quote {
  font-size: 28rpx;
  color: var(--text-2);
  border-left: 4rpx solid var(--brand);
  padding: 8rpx 0 8rpx 22rpx;
  margin-bottom: 24rpx;
  line-height: 1.8;
}

.b-li {
  font-size: 30rpx;
  line-height: 1.8;
  margin-bottom: 12rpx;
  color: var(--text);
}

.b-img {
  width: 100%;
  border-radius: 8rpx;
  margin: 8rpx 0 24rpx;
  background: var(--bg-soft);
}

.reader-foot {
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.reader-note {
  font-size: 22rpx;
  color: var(--text-3);
  flex: 1;
}

.error-copy {
  margin-top: 24rpx;
}
