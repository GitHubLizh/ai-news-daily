<view class="wrap">
  <block wx:if="{{ready}}">
    <view class="feed-head">
      <text class="feed-scope">我的收藏</text>
      <text>共 {{total}} 条</text>
    </view>

    <view class="empty" wx:if="{{total === 0}}">
      <text class="empty-title">还没有收藏</text>
      <text>点击资讯卡片右下角的「☆ 收藏」，之后可以在这里集中查看。</text>
    </view>

    <news-item
      wx:for="{{items}}"
      wx:key="id"
      item="{{item}}"
      read="{{item.isRead}}"
      saved="{{item.isSaved}}"
      bindopen="onItemOpen"
      bindsave="onItemSave"
      bindread="onItemRead"
      bindcopy="onItemCopy"
    />
  </block>
  <block wx:else>
    <view class="skeleton"></view>
    <view class="skeleton"></view>
  </block>
</view>
